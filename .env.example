# ==========================================
# CodeSphere Environment Variables Example
# ==========================================

# --- Backend Server Configuration ---
PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesphere?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173
NODE_ENV=production

# Optional: GitHub Personal Access Token to avoid GitHub API 60 req/hr rate limiting
GITHUB_TOKEN=

# --- Frontend Configuration ---
# Set to your deployed backend URL (e.g., https://your-backend.onrender.com/api)
# Or set to /api if deploying frontend & backend unified on the same host
VITE_API_BASE_URL=http://localhost:5001/api
