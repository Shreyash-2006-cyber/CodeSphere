{
  "name": "codesphere-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CodeSphere - Fullstack Developer Tracking & Analytics Platform",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm run install:server && npm run install:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run install:all && npm run build:frontend",
    "start": "node server/server.js",
    "dev:server": "npm --prefix server run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "codesphere",
    "react",
    "vite",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC"
}
