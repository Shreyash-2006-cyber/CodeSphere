# Port for the Node/Express server (default: 5001)
PORT=5001

# MongoDB Connection String (MongoDB Atlas or local instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesphere?retryWrites=true&w=majority

# Secret key for JWT signing and verification
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed origins for CORS (comma-separated if multiple, or leave empty to allow all origins in development)
# In production with separate frontend: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Optional: GitHub Personal Access Token to avoid GitHub API 60 req/hr rate limiting
GITHUB_TOKEN=

# Environment mode
NODE_ENV=production
